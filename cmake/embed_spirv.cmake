# Embed compiled SPIR-V shaders in a C header for tensor_vulkan.c.
#
#   cmake -DSPV_DIR=<dir with NAME.spv files> -DNAMES=a,b,c -DOUT=<header> -P embed_spirv.cmake
#
# Writes, for each NAME, `static const uint32_t spv_NAME[] = { ... };`. SPIR-V
# is a stream of little-endian 32-bit words, which this reassembles from bytes.
# NAMES is comma-separated so that no ';' reaches the shell running the command.

string(REPLACE "," ";" NAMES "${NAMES}")
file(WRITE "${OUT}.tmp" "// Generated by cmake/embed_spirv.cmake from shaders/vk; do not edit\n#include <stdint.h>\n\n")
foreach(name ${NAMES})
    file(READ "${SPV_DIR}/${name}.spv" hex HEX)
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1," words "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f]+,){8})" "\\1\n    " words "${words}")
    file(APPEND "${OUT}.tmp" "static const uint32_t spv_${name}[] = {\n    ${words}\n};\n\n")
endforeach()
# replace the header only when it changed, so dependents rebuild only then
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
