#version 450
#include "common.glsl"
// y = activate(y + bias) over a [rows x cols] buffer, first saving y + bias
// in z when save_z is set (the values before activation, for GELU's
// derivative). Softmax passes through here and is applied by softmax.comp.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer BufY { float y[]; };
layout(std430, binding = 1) readonly buffer BufBias { float bias[]; };
layout(std430, binding = 2) buffer BufZ { float z[]; };

layout(push_constant) uniform Params {
    uint n;         // rows * cols
    uint cols;
    uint act;
    uint save_z;
} pc;

void main()
{
    GRID_LOOP(i, pc.n)
    {
        float v = y[i] + bias[i % pc.cols];
        if (pc.save_z != 0)
            z[i] = v;
        y[i] = activate(v, pc.act);
    }
}
