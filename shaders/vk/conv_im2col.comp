#version 450
#include "common.glsl"
// im2col: one row of columns per output position, cols [batch*OH*OW x C*K*K],
// column index (c*K + i)*K + j as the CPU path orders them; zero outside the
// input (padding). One invocation per (sample, channel, output position) writes
// that position's K*K values for its channel.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) writeonly buffer BufCols { float cols[]; };

layout(push_constant) uniform Params { WindowDims d; } pc;

void main()
{
    WindowDims d = pc.d;
    uint kk = d.K * d.K;
    GRID_LOOP(idx, d.batch * d.C * d.OH * d.OW)
    {
        uint ow = idx % d.OW, t = idx / d.OW;
        uint oh = t % d.OH;
        t /= d.OH;
        uint c = t % d.C, b = t / d.C;

        uint xs = (b * d.C + c) * d.H * d.W;
        uint out_i = ((b * d.OH + oh) * d.OW + ow) * d.C * kk + c * kk;
        int ih0 = int(oh * d.S) - int(d.P), iw0 = int(ow * d.S) - int(d.P);
        for (uint i = 0; i < d.K; i++)
        {
            int ih = ih0 + int(i);
            bool row_in = ih >= 0 && ih < int(d.H);
            for (uint j = 0; j < d.K; j++)
            {
                int iw = iw0 + int(j);
                cols[out_i + i * d.K + j] = row_in && iw >= 0 && iw < int(d.W) ? x[xs + uint(ih) * d.W + uint(iw)] : 0.0;
            }
        }
    }
}
