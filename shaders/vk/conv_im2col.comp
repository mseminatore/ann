#version 450
#include "common.glsl"
// im2col: one row of columns per output position, cols [batch*OH*OW x C*K*K],
// column index (c*K + i)*K + j as the CPU path orders them; zero outside the
// input (padding). One invocation per column value, so consecutive invocations
// write consecutive addresses.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer BufX { float x[]; };
layout(std430, binding = 1) writeonly buffer BufCols { float cols[]; };

layout(push_constant) uniform Params { WindowDims d; } pc;

void main()
{
    WindowDims d = pc.d;
    uint kk = d.K * d.K, ckk = d.C * kk;
    GRID_LOOP(idx, d.batch * d.OH * d.OW * ckk)
    {
        uint col = idx % ckk, row = idx / ckk;
        uint c = col / kk, i = (col % kk) / d.K, j = col % d.K;
        uint ow = row % d.OW, t = row / d.OW;
        uint oh = t % d.OH, b = t / d.OH;

        int ih = int(oh * d.S + i) - int(d.P), iw = int(ow * d.S + j) - int(d.P);
        cols[idx] = ih >= 0 && ih < int(d.H) && iw >= 0 && iw < int(d.W)
            ? x[((b * d.C + c) * d.H + uint(ih)) * d.W + uint(iw)] : 0.0;
    }
}
