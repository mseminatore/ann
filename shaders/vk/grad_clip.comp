#version 450
#include "common.glsl"
// Clamp each gradient element to [-max_grad, max_grad]

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer BufGrad { float g[]; };

layout(push_constant) uniform Params {
    uint n;
    float max_grad;
} pc;

void main()
{
    GRID_LOOP(i, pc.n)
        g[i] = clamp(g[i], -pc.max_grad, pc.max_grad);
}
