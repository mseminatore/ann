#version 450
#include "common.glsl"
// Zero a masked layer's values or gradients at its masked steps (see
// ann_add_embedding_masked): v [batch][C][steps], mask [batch][steps], 1 kept.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer BufV { float v[]; };
layout(std430, binding = 1) readonly buffer BufMask { float mask[]; };

layout(push_constant) uniform Params {
    uint n, steps, nodes;
} pc;

void main()
{
    GRID_LOOP(i, pc.n)
        if (mask[(i / pc.nodes) * pc.steps + (i % pc.nodes) % pc.steps] == 0.0)
            v[i] = 0.0;
}
