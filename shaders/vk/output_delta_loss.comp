#version 450
#include "common.glsl"
// Output layer: delta = t - y and each row's loss, one invocation per row.
// mode 0 = MSE (squared error), 1 = categorical cross-entropy, 2 = binary
// cross-entropy (sigmoid outputs); y is clamped like ann_cross_entropy_term().

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer BufY { float y[]; };
layout(std430, binding = 1) readonly buffer BufT { float t[]; };
layout(std430, binding = 2) writeonly buffer BufDelta { float delta[]; };
layout(std430, binding = 3) writeonly buffer BufLoss { float row_loss[]; };

layout(push_constant) uniform Params {
    uint rows;
    uint cols;
    uint mode;
} pc;

void main()
{
    GRID_LOOP(row, pc.rows)
    {
        float s = 0.0;
        for (uint n = 0; n < pc.cols; n++)
        {
            uint i = row * pc.cols + n;
            float yi = y[i], ti = t[i];
            delta[i] = ti - yi;
            if (pc.mode == 0)
            {
                float d = yi - ti;
                s += d * d;
            }
            else
            {
                float c = clamp(yi, 1e-7, 1.0 - 1e-7);
                s += pc.mode == 2 ? -(ti * log(c) + (1.0 - ti) * log(1.0 - c)) : -ti * log(c);
            }
        }
        row_loss[row] = s;
    }
}
