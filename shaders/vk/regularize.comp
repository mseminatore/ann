#version 450
#include "common.glsl"
// L2 then L1 regularization: w *= decay, then w moves l1 toward zero.
// decay = 1 and l1 = 0 leave w unchanged.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer BufW { float w[]; };

layout(push_constant) uniform Params {
    uint n;
    float decay;
    float l1;
} pc;

void main()
{
    GRID_LOOP(i, pc.n)
    {
        float wi = w[i] * pc.decay;
        if (wi > 0.0)
            wi -= pc.l1;
        else if (wi < 0.0)
            wi += pc.l1;
        w[i] = wi;
    }
}
