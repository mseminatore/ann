#version 450
#include "common.glsl"
// Add up partial sums from slices of a split sum: element i of the result is
// the sum over slices s of partial[s * n + i]. The first n_first elements are
// added to c, the rest (n - n_first of them) to c2: a conv weight gradient's
// dW then db. The host binds c as c2 when n_first == n.
//
// One workgroup per element (looping over elements beyond the workgroup
// count): its invocations take every 64th slice, then add up their sums in
// shared memory. There are few elements and up to hundreds of slices, so one
// invocation per element would leave the GPU nearly idle.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer BufPartial { float partial[]; };
layout(std430, binding = 1) buffer BufC { float c[]; };
layout(std430, binding = 2) buffer BufC2 { float c2[]; };

layout(push_constant) uniform Params {
    uint n;         // elements in each slice
    uint slices;
    uint n_first;   // elements that go to c
} pc;

shared float part[64];

void main()
{
    uint t = gl_LocalInvocationID.x;
    for (uint i = gl_WorkGroupID.x; i < pc.n; i += gl_NumWorkGroups.x)
    {
        float s = 0.0;
        for (uint k = t; k < pc.slices; k += 64)
            s += partial[k * pc.n + i];
        part[t] = s;
        barrier();
        for (uint w = 32; w > 0; w /= 2)
        {
            if (t < w)
                part[t] += part[t + w];
            barrier();
        }
        if (t == 0)
        {
            if (i < pc.n_first)
                c[i] += part[0];
            else
                c2[i - pc.n_first] += part[0];
        }
        barrier();
    }
}
