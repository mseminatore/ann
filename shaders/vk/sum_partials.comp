#version 450
#include "common.glsl"
// Add up a split-K GEMM's partial sums: c[i] += sum over slices s of
// partial[s * n + i]

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer BufPartial { float partial[]; };
layout(std430, binding = 1) buffer BufC { float c[]; };

layout(push_constant) uniform Params {
    uint n;         // elements of C
    uint slices;
} pc;

void main()
{
    GRID_LOOP(i, pc.n)
    {
        float s = 0.0;
        for (uint k = 0; k < pc.slices; k++)
            s += partial[k * pc.n + i];
        c[i] += s;
    }
}
